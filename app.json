{
  "expo": {
    "name": "Pulse Messenger",
    "slug": "pulse-messenger",
    "version": "1.0.0",
    "description": "A fast, private, and elegant messenger. Real-time chats, groups, channels, and voice notes — all in one place.",
    "owner": "abdulmajidkhan007",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#3D9AE8",
    "backgroundColor": "#0F1923",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1923"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pulse.messenger",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Pulse needs microphone access to record voice messages.",
        "NSPhotoLibraryUsageDescription": "Pulse needs photo library access to share images.",
        "NSCameraUsageDescription": "Pulse needs camera access to take and share photos.",
        "NSContactsUsageDescription": "Pulse uses your contacts to help you find friends."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0F1923"
      },
      "package": "com.pulse.messenger",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "READ_CONTACTS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Pulse Messenger",
      "shortName": "Pulse",
      "lang": "en",
      "themeColor": "#3D9AE8",
      "backgroundColor": "#0F1923",
      "description": "A fast, private, and elegant messenger."
    },
    "plugins": [
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "Pulse needs microphone access to record voice messages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pulse needs photo library access to share images.",
          "cameraPermission": "Pulse needs camera access to take and share photos."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-haptics"
    ],
    "extra": {
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/replace-with-your-eas-project-id"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
